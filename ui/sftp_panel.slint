import { Theme } from "theme.slint";
import { ScrollView, ListView } from "std-widgets.slint";
import { TabInfo } from "tabs.slint";
import { AutoScrollTextInput } from "widgets.slint";

// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------

export struct SftpEntry {
    name: string,
    full-path: string,
    is-dir: bool,
    size: string,
    raw-size: int,
    modified: string,
    raw-modified: int,
    kind: string,
    kind-en: string,
    icon: string,
    permissions: string,
    owner: string,
    group: string,
    mode: int,        // POSIX permission bits, for the chmod dialog (#84)
    selected: bool,   // multi-select checkbox state (#100)
}

component SftpHeaderCell inherits Rectangle {
    in property <string> label;
    in property <string> column;
    in property <string> sort-column;
    in property <bool> sort-asc: true;
    in property <bool> align-right: false;
    in property <bool> left-align: false;
    in property <bool> resizable: true;
    in property <length> current-width: 0px;
    in property <length> col-min-w: 0px;
    in property <length> col-max-w: 100000px;
    callback clicked(string);
    callback resize-to(length);
    property <length> drag-start-x;
    property <length> drag-start-width;
    property <length> drag-current-x;
    property <length> drag-target-w;

    height: 20px;
    background: ta.has-hover ? Theme.bg-hover : transparent;
    ta := TouchArea {
        width: parent.width - (root.resizable ? 6px : 0px);
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(root.column); }
    }
    HorizontalLayout {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        alignment: root.left-align ? start : center;
        spacing: 2px;
        Text {
            text: root.label;
            color: root.sort-column == root.column ? Theme.text-primary : Theme.text-muted;
            font-size: Theme.fs-xs;
            horizontal-alignment: root.left-align ? left : center;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: root.sort-column == root.column ? 12px : 0px;
            text: root.sort-column == root.column ? (root.sort-asc ? "\u{E5CE}" : "\u{E5CF}") : "";
            color: Theme.text-primary;
            font-family: "Material Icons";
            font-size: Theme.fs-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.resizable : Rectangle {
        x: parent.width - 3px;
        width: 6px;
        height: parent.height;
        background: transparent;
        Rectangle {
            x: 3px;
            width: 1px;
            height: parent.height;
            background: Theme.border-strong;
        }
        resize-ta := TouchArea {
            mouse-cursor: ew-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.drag-start-x = self.absolute-position.x + self.mouse-x;
                    root.drag-start-width = root.current-width;
                }
            }
            moved => {
                if (self.pressed) {
                    root.drag-current-x = self.absolute-position.x + self.mouse-x;
                    root.drag-target-w = root.drag-start-width + root.drag-current-x - root.drag-start-x;
                    root.resize-to(max(root.col-min-w, min(root.col-max-w, root.drag-target-w)));
                }
            }
        }
    }
}

export struct SftpTreeNode {
    path: string,
    name: string,
    depth: int,
    expanded: bool,
    has-children: bool,
    is-dir: bool,
}

export struct TunnelInfo {
    id: string,
    name: string,
    kind: string,
    bind: string,
    target: string,
    status: string,
    active: bool,
}

component SftpTooltip inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    in property <bool> hover;
    in property <length> anchor-width: 24px;
    in property <length> anchor-height: 22px;
    property <bool> visible-after-delay: false;

    y: root.anchor-height + 6px;
    x: root.anchor-width - self.width;
    width: tip-txt.preferred-width + 16px;
    height: 22px;
    visible: root.visible-after-delay;
    z: 100;
    background: root.danger ? Theme.danger-hover-solid : Theme.bg-hover;
    border-radius: Theme.radius-sm;
    border-width: 0px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 4px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: #00000060;
    tooltip-delay := Timer {
        interval: 500ms;
        running: root.hover && !root.visible-after-delay;
        triggered => { root.visible-after-delay = true; }
    }
    changed hover => {
        if (!root.hover) { root.visible-after-delay = false; }
    }
    tip-txt := Text {
        text: root.text;
        color: Theme.text-primary;
        font-size: Theme.fs-xs;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

component SftpToolbarIcon inherits Rectangle {
    in property <string> glyph;
    in property <brush> glyph-color;
    in property <length> glyph-size;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.glyph;
        font-family: "Material Icons";
        color: root.glyph-color;
        font-size: root.glyph-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One row of the file-list right-click context menu.
component SftpMenuItem inherits Rectangle {
    in property <string> label;
    in property <brush> tint: Theme.text-primary;
    in property <bool> enabled: true;   // disabled items grey out + ignore clicks
    callback clicked();
    height: 26px;
    border-radius: Theme.radius-sm;
    background: (root.enabled && ta.has-hover) ? Theme.bg-hover : transparent;
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.label;
        color: root.enabled ? root.tint : Theme.text-muted;
        font-size: Theme.fs-sm;
        overflow: elide;
        vertical-alignment: center;
        height: parent.height;
    }
}

// ---------------------------------------------------------------------------
// SftpPanel - left directory tree + right file listing
// ---------------------------------------------------------------------------

export component SftpPanel inherits Rectangle {
    // --- Properties --------------------------------------------------------
    in property <string>  current-path: "/";
    in property <[SftpEntry]>    entries;
    in property <string>  status: @tr("SFTP not connected");
    in property <bool>    loading: false;
    in property <[SftpTreeNode]> tree-nodes: [];
    in property <int> tree-focus-index: -1;
    in property <string> current-tab-id;
    in property <[TabInfo]> transfer-targets: [];
    in property <string> sort-key: "";
    in property <int> sort-dir: 0; // 0 default / 1 asc / -1 desc
    in property <[TunnelInfo]> tunnels: [];
    in property <bool> lang-en: false;
    in property <string> dock-edge: "bottom";
    in property <bool> collapsed: false;   // when true only the toolbar shows
    in property <bool> show-tree: true;    // hide the directory tree when narrow (#dock)
    in property <bool> zebra-rows: true;
    in property <bool> compact: false;     // side-docked + collapsed → render nothing but a clean strip (#dock)
    property <length> tree-min-width: 96px;
    property <length> tree-width: 220px;
    property <length> tree-reserve-width: 240px;
    property <length> tree-max-width: max(root.tree-min-width, root.width - root.tree-reserve-width);
    // Responsive columns: only when docked left/right (narrow, width-adjustable).
    // Docked top/bottom the panel is wide and can only be resized vertically, so
    // always show every column there (show-tree is true exactly in that case).
    // In side dock, hide columns from the right edge as the list becomes too
    // narrow. The name column always remains visible.
    property <length> list-w: root.show-tree ? root.width - root.tree-width : root.width;
    property <length> name-min: 180px;     // narrower than this → start dropping columns
    property <length> name-col-w: 440px;
    property <length> name-col-max-w: max(120px, root.list-w - 6px);
    property <length> size-col-w: 80px;
    property <length> type-col-w: 80px;
    property <length> modified-col-w: 120px;
    property <length> perm-col-w: 80px;
    property <length> owner-col-w: 120px;
    property <length> owner-min-w: 120px;
    // A hidden directory tree is also used by compact horizontal layouts, so
    // it must not decide whether the side-toolbar arrangement is active.
    property <bool> side-docked: root.dock-edge == "left" || root.dock-edge == "right";
    // Low-priority actions disappear in order only when side-docked space runs out.
    pure function show-action(hidden-at: length) -> bool {
        // In a side dock the navigation controls remain in the top toolbar, so
        // retain the normal thresholds instead of borrowing space from them.
        return !root.side-docked || root.width >= hidden-at;
    }
    property <bool> show-owner-col: true;
    property <bool> show-perm-col: true;
    property <bool> show-modified-col: true;
    property <bool> show-type-col: true;
    property <bool> show-size-col: true;
    property <length> visible-size-col-w: root.show-size-col ? root.size-col-w : 0px;
    property <length> visible-type-col-w: root.show-type-col ? root.type-col-w : 0px;
    property <length> visible-modified-col-w: root.show-modified-col ? root.modified-col-w : 0px;
    property <length> visible-perm-col-w: root.show-perm-col ? root.perm-col-w : 0px;
    property <length> visible-owner-min-w: root.show-owner-col ? root.owner-min-w : 0px;
    property <length> name-col-view-w: min(root.name-col-w, root.name-col-max-w);
    property <length> size-col-view-w: root.visible-size-col-w;
    property <length> type-col-view-w: root.visible-type-col-w;
    property <length> modified-col-view-w: root.visible-modified-col-w;
    property <length> perm-col-view-w: root.visible-perm-col-w;
    property <bool> toolbar-enabled: !root.collapsed;
    property <int> selected-row: -1;       // clicked/highlighted file-list row (#70)
    property <string> sort-column: "name";
    property <bool> sort-asc: true;
    property <string> focused-tree-path;
    property <bool> tree-name-click-pending: false;
    property <string> pending-tree-click-path;
    property <bool> tree-scroll-pending: false;
    property <string> last-tree-scroll-path;
    property <int> selection-anchor-row: -1;
    property <bool> suppress-double-open: false;
    in property <int> selected-count;      // number of checked entries (#100)
    in property <int> restore-selected-row: -1;
    in property <length> restore-viewport-y;
    in property <bool> has-restore-viewport: false;
    in property <int> list-scroll-token: 0;
    in property <int> list-scroll-mode: 0;
    property <int> file-scroll-attempts: 0;
    property <int> file-scroll-mode: 0;
    property <length> file-viewport-y;
    // Panel-level right-click context menu (#84). One menu for the whole list:
    // an empty `menu-target` means the click landed on whitespace, which greys
    // out the item-specific actions (download/rename/etc.) but keeps new/refresh.
    property <length> menu-x;
    property <length> menu-y;
    property <string> menu-target;          // "" = whitespace
    property <string> menu-target-name;
    property <int>    menu-target-row: -1;
    property <bool>   menu-target-is-dir;
    property <int>    menu-target-mode;     // permission bits for the chmod dialog
    property <string> panel-mode: "files";
    property <string> tunnel-kind: "local";
    property <string> tunnel-name: "";
    property <string> tunnel-bind: "127.0.0.1";
    property <string> tunnel-bind-port: "1080";
    property <string> tunnel-host: "127.0.0.1";
    property <string> tunnel-host-port: "80";
    property <length> tree-menu-x;
    property <length> tree-menu-y;
    property <string> load-more-label: root.lang-en ? "Load more..." : "加载更多...";
    property <string> load-all-label: root.lang-en ? "Load all" : "加载全部";

    // --- Callbacks ---------------------------------------------------------
    callback toggle-collapsed();    // minimise / restore the panel
    callback navigate(string);
    callback remember-list-position(string, length);
    callback navigate-back();
    callback navigate-forward();
    callback download(string);
    callback archive-download(string);
    callback upload-clicked(string /* remote dir */, bool /* folder */);
    callback refresh(string);
    callback load-more();
    callback load-all();
    callback sort-request(string /* column */, bool /* ascending */);
    callback clear-sort();
    callback tree-expand(string, bool);   // toggle expand/collapse; navigate only when expanding
    callback tree-probe(string);          // load child information without expanding
    callback tree-load-more(string);
    callback delete(string);        // remove a remote file/dir
    callback move-request(string /* path */, string /* current name */);
    callback move-selected-request();
    callback toggle-select(int);    // toggle a row's multi-select checkbox (#100)
    callback select-single(int);    // clear selection and select one row
    callback select-range(int /* anchor */, int /* row */, bool /* keep existing */);
    callback select-all();
    callback download-selected();   // download all checked entries (#100)
    callback archive-download-selected(); // tar checked entries into one archive
    callback delete-selected();     // delete all checked entries (#100)
    callback copy-to-target(string /* path */, string /* target tab */);
    callback copy-selected-to-target(string /* target tab */);
    callback view(string);          // open read-only in the built-in viewer
    callback edit(string);          // open writable in the built-in editor
    callback open-external(string);     // open with the OS default app (#81)
    callback edit-external(string);     // open externally + watch/re-upload (#81)
    callback tunnel-add(string /* name */, string /* kind */, string /* bind */, string /* bind-port */, string /* host */, string /* host-port */);
    callback tunnel-stop(string /* id */);
    callback clear-failed-tunnels();
    // Context-menu extensions (#69). The *-request callbacks open dialogs in
    // the app shell; copy-path goes straight to the system clipboard.
    callback rename-request(string /* path */, string /* current name */);
    callback rename-submit(string /* path */, string /* new name */);
    callback chmod-request(string /* path */, string /* name */, int /* mode */);
    callback copy-path(string);
    callback new-folder(string /* parent dir */);
    callback new-file(string /* parent dir */);
    // Drag-to-dock: empty areas of the panel are a grab handle; coordinates are
    // reported in window space so the parent can compute the target edge (#dock).
    callback dock-drag-move(length /* abs-x */, length /* abs-y */);
    callback dock-drag-end();

    // -----------------------------------------------------------------------
    background: Theme.term-bg;
    // Focus sink used to blur the path input without changing layout.
    input-blur-scope := FocusScope {
        key-pressed(e) => {
            if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control)
                    && (e.text == "a" || e.text == "A" || e.text == "\u{0001}")) {
                root.select-all();
                accept
            } else {
                reject
            }
        }
    }

    // Keep the editable path bar in sync when the directory changes elsewhere
    // (tree click, file double-click, terminal cd) (#54).
    changed current-path => {
        root.sync-path-inputs();
        root.selected-row = -1;
        root.focused-tree-path = root.current-path;
    }

    // Rust increments this only after the new directory rows have been set.
    // 1 = start at top, 2 = restore exact parent position, 3 = reveal selection.
    changed list-scroll-token => {
        if (root.list-scroll-mode != 0) {
            root.file-scroll-mode = root.list-scroll-mode;
            if (root.file-scroll-mode == 1) {
                root.file-viewport-y = 0px;
            } else if (root.file-scroll-mode == 2) {
                root.file-viewport-y = root.restore-viewport-y;
            }
            root.file-scroll-attempts = 2;
        }
    }

    changed collapsed => {
        if (!root.collapsed) {
            root.scroll-path-to-end();
        }
    }

    public function scroll-path-to-end() {
        path-input.set-selection-offsets(1000000, 1000000);
        path-input.scroll-to-end();
        side-path-input.set-selection-offsets(1000000, 1000000);
        side-path-input.scroll-to-end();
    }

    public function sync-path-inputs() {
        path-input.text = root.current-path;
        side-path-input.text = root.current-path;
        root.scroll-path-to-end();
    }

    tree-name-click-delay := Timer {
        interval: 600ms;
        running: root.tree-name-click-pending;
        triggered => { root.tree-name-click-pending = false; }
    }

    changed list-w => {
        root.name-col-w = min(root.name-col-w, root.name-col-max-w);
    }

    changed tree-focus-index => {
        if (root.tree-focus-index >= 0 && root.current-path != root.last-tree-scroll-path) {
            root.tree-scroll-pending = true;
            root.last-tree-scroll-path = root.current-path;
        }
    }

    public function open-entry(path: string, is-dir: bool) {
        if (is-dir) {
            root.remember-list-position(root.current-path, root.file-viewport-y);
            root.navigate(path);
        } else {
            root.open-external(path);
        }
    }

    // Re-docking is intentionally limited to the toolbar grip immediately left
    // of the path input, so file-list/tree whitespace keeps normal pointer use.

    // Hidden entirely when side-docked + collapsed: the horizontal toolbar would
    // otherwise squish into an unusable vertical strip. `visible` (not `if`) so
    // ids like path-input stay accessible to handlers. The parent floats a clean
    // expand button over this (#dock).
    VerticalLayout {
        visible: !root.compact;
        spacing: 0;

        // --- Toolbar (full width) ------------------------------------------
        Rectangle {
            width: root.width;
            height: root.side-docked && root.panel-mode == "files" ? 58px : 32px;
            z: 100;
            background: Theme.bg-panel-alt;

            HorizontalLayout {
                y: 0px;
                width: parent.width;
                height: 32px;
                // Tooltips from the first-row icon tabs may extend into the
                // second row of a side dock; keep them above the path field.
                z: 2;
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 4px;

                // Dedicated drag handle to re-dock the panel. The toolbar is full
                // of controls, so dragging "empty space" is unreliable; this grip
                // is always grabbable and reports window-space coords (#dock).
                Rectangle {
                    visible: root.toolbar-enabled;
                    width: 20px;
                    y: (parent.height - self.height) / 2;
                    height: 22px;
                    grip-ta := TouchArea {
                        mouse-cursor: move;
                        moved => {
                            root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.up) { root.dock-drag-end(); }
                        }
                    }
                    Text {
                        text: "\u{E945}";   // drag_indicator
                        font-family: "Material Icons";
                        color: grip-ta.has-hover ? Theme.text-secondary : Theme.text-muted;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }

                Rectangle {
                    visible: root.toolbar-enabled;
                    width: 8px;
                    height: 22px;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 1px;
                        height: 14px;
                        background: Theme.border-strong;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: root.panel-mode == "files" ? Theme.accent : (files-tab-ta.has-hover ? Theme.bg-hover : transparent);
                    files-tab-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.panel-mode = "files"; }
                    }
                    Text {
                        text: "\u{E2C7}";
                        font-family: "Material Icons";
                        color: root.panel-mode == "files" ? #ffffff : Theme.text-secondary;
                        font-size: Theme.fs-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    SftpTooltip { text: @tr("Files"); hover: files-tab-ta.has-hover; anchor-width: parent.width; }
                }
                Rectangle {
                    width: 28px;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: root.panel-mode == "tunnels" ? Theme.accent : (tunnels-tab-ta.has-hover ? Theme.bg-hover : transparent);
                    tunnels-tab-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.panel-mode = "tunnels"; }
                    }
                    Text {
                        text: "\u{E0B6}";
                        font-family: "Material Icons";
                        color: root.panel-mode == "tunnels" ? #ffffff : Theme.text-secondary;
                        font-size: Theme.fs-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    SftpTooltip { text: @tr("Tunnels"); hover: tunnels-tab-ta.has-hover; anchor-width: parent.width; }
                }

                if root.panel-mode == "files" && root.toolbar-enabled : Rectangle {
                    width: 8px;
                    height: 22px;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 1px;
                        height: 14px;
                        background: Theme.border-strong;
                    }
                }

                // Upload: a small menu offers file vs folder (#85). The remote
                // SFTP upload handles both; only the local picker differs.
                ul-btn := Rectangle {
                    visible: root.panel-mode == "files" && root.toolbar-enabled && root.show-action(232px);
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: (root.toolbar-enabled && ul-ta.has-hover) ? Theme.bg-hover : transparent;
                    ul-ta := TouchArea {
                        mouse-cursor: root.toolbar-enabled ? pointer : default;
                        clicked => { if (root.toolbar-enabled) { ul-menu.show(); } }
                    }
                    SftpToolbarIcon { width: parent.width; height: parent.height; glyph: "\u{E2C6}"; glyph-color: root.toolbar-enabled ? Theme.text-secondary : Theme.text-muted; glyph-size: Theme.fs-md; }
                    SftpTooltip { text: root.lang-en ? "Upload" : "上传"; hover: ul-ta.has-hover; }
                    ul-menu := PopupWindow {
                        x: 0; y: parent.height + 2px;
                        width: 124px;
                        height: 2 * 27px + 8px;
                        Rectangle {
                            background: Theme.bg-panel;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                SftpMenuItem {
                                    label: @tr("Upload file");
                                    clicked => { root.upload-clicked(root.current-path, false); }
                                }
                                SftpMenuItem {
                                    label: @tr("Upload folder");
                                    clicked => { root.upload-clicked(root.current-path, true); }
                                }
                            }
                        }
                    }
                }

                // Batch actions on checked entries (#100).
                if root.panel-mode == "files" : Rectangle {
                    visible: root.show-action(260px);
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: (root.toolbar-enabled && root.selected-count > 0 && dls-ta.has-hover) ? Theme.bg-hover : transparent;
                    dls-ta := TouchArea {
                        mouse-cursor: root.toolbar-enabled && root.selected-count > 0 ? pointer : default;
                        clicked => { if (root.toolbar-enabled && root.selected-count > 0) { root.download-selected(); } }
                    }
                    SftpToolbarIcon { width: parent.width; height: parent.height; glyph: "\u{E2C4}"; glyph-color: root.toolbar-enabled && root.selected-count > 0 ? Theme.text-secondary : Theme.text-secondary.with-alpha(0.4); glyph-size: Theme.fs-md; }
                    SftpTooltip { text: root.lang-en ? "Download" : "下载"; hover: dls-ta.has-hover && root.toolbar-enabled && root.selected-count > 0; }
                }
                if root.panel-mode == "files" : Rectangle {
                    visible: root.show-action(288px);
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: (root.toolbar-enabled && root.selected-count > 0 && mvs-ta.has-hover) ? Theme.bg-hover : transparent;
                    mvs-ta := TouchArea {
                        mouse-cursor: root.toolbar-enabled && root.selected-count > 0 ? pointer : default;
                        clicked => { if (root.toolbar-enabled && root.selected-count > 0) { root.move-selected-request(); } }
                    }
                    SftpToolbarIcon { width: parent.width; height: parent.height; glyph: "\u{E675}"; glyph-color: root.toolbar-enabled && root.selected-count > 0 ? Theme.text-secondary : Theme.text-secondary.with-alpha(0.4); glyph-size: Theme.fs-md; }
                    SftpTooltip { text: root.lang-en ? "Move" : "移动"; hover: mvs-ta.has-hover && root.toolbar-enabled && root.selected-count > 0; }
                }
                if root.panel-mode == "files" : Rectangle {
                    visible: root.show-action(316px);
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: (root.toolbar-enabled && root.selected-count > 0 && dels-ta.has-hover)
                        ? Theme.danger-hover-solid
                        : transparent;
                    dels-ta := TouchArea {
                        mouse-cursor: root.toolbar-enabled && root.selected-count > 0 ? pointer : default;
                        clicked => { if (root.toolbar-enabled && root.selected-count > 0) { root.delete-selected(); } }
                    }
                    SftpToolbarIcon { width: parent.width; height: parent.height; glyph: "\u{E872}"; glyph-color: root.toolbar-enabled && root.selected-count > 0 ? Theme.danger : Theme.danger.with-alpha(0.4); glyph-size: Theme.fs-md; }
                    SftpTooltip { text: root.lang-en ? "Delete" : "删除"; danger: true; hover: dels-ta.has-hover && root.toolbar-enabled && root.selected-count > 0; }
                }

                // Copy the current path to the clipboard.
                Rectangle {
                    visible: root.panel-mode == "files" && root.toolbar-enabled && root.show-action(344px);
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: (root.toolbar-enabled && copy-ta.has-hover) ? Theme.bg-hover : transparent;
                    copy-ta := TouchArea {
                        mouse-cursor: root.toolbar-enabled ? pointer : default;
                        clicked => {
                            if (root.toolbar-enabled) {
                                path-input.select-all();
                                path-input.copy();
                                path-input.clear-selection();
                            }
                        }
                    }
                    SftpToolbarIcon { width: parent.width; height: parent.height; glyph: "\u{E14D}"; glyph-color: root.toolbar-enabled ? Theme.text-secondary : Theme.text-muted; glyph-size: Theme.fs-sm; }
                    SftpTooltip { text: root.lang-en ? "Copy path" : "复制路径"; hover: copy-ta.has-hover; }
                }

                // Paste a path from the clipboard and jump straight to it.
                Rectangle {
                    visible: root.panel-mode == "files" && root.toolbar-enabled && root.show-action(372px);
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: (root.toolbar-enabled && pj-ta.has-hover) ? Theme.bg-hover : transparent;
                    pj-ta := TouchArea {
                        mouse-cursor: root.toolbar-enabled ? pointer : default;
                        clicked => {
                            if (root.toolbar-enabled) {
                                path-input.select-all();
                                path-input.paste();
                                side-path-input.select-all();
                                side-path-input.paste();
                                root.navigate(root.side-docked ? side-path-input.text : path-input.text);
                            }
                        }
                    }
                    SftpToolbarIcon { width: parent.width; height: parent.height; glyph: "\u{E14F}"; glyph-color: root.toolbar-enabled ? Theme.text-secondary : Theme.text-muted; glyph-size: Theme.fs-sm; }
                    SftpTooltip { text: root.lang-en ? "Paste and go" : "粘贴并跳转"; hover: pj-ta.has-hover; }
                }

                // Reserve the two navigation buttons placed immediately before
                // the path field. Their visual positions are updated below.
                Rectangle {
                    visible: root.panel-mode == "files" && root.toolbar-enabled;
                    width: 56px;
                }

                // Editable path bar: type or paste a path and press Enter to
                // jump there. Toolbar buttons sit before it, so the path field
                // absorbs the remaining width without pushing controls left.
                path-wrap := Rectangle {
                    // Keep a non-interactive flexible placeholder in side docks.
                    // It preserves the normal toolbar geometry while the real
                    // editable path field is rendered on the second row.
                    visible: root.panel-mode == "files" && root.toolbar-enabled;
                    // Do not give this flexible item a fixed width: otherwise
                    // HorizontalLayout keeps it at that width instead of using
                    // the space between the toolbar controls and collapse button.
                    horizontal-stretch: 1;
                    min-width: 0px;
                    height: 22px;
                    changed width => {
                        if (!root.collapsed) {
                            root.scroll-path-to-end();
                        }
                    }
                    clip: true;
                    border-radius: Theme.radius-sm;
                    background: root.side-docked ? transparent : Theme.bg-root;
                    border-width: root.side-docked ? 0px : 1px;
                    border-color: path-input.has-focus ? Theme.accent : Theme.border-subtle;
                    path-input := AutoScrollTextInput {
                        visible: !root.side-docked;
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: root.current-path;
                        text-color: Theme.text-primary;
                        // CJK-capable font so typed Chinese isn't tofu (#54).
                        font-family: Theme.ui-font-family;
                        font-size: Theme.fs-sm;
                        read-only: !root.toolbar-enabled;
                        accepted => { if (root.toolbar-enabled) { root.navigate(self.text); } }
                    }
                }

                // When the path field is visible it is the sole flexible item,
                // keeping the collapse button flush with the toolbar's right edge.
                // Other panel modes still need this spacer because they omit it.
                if !(root.panel-mode == "files" && root.toolbar-enabled) : Rectangle {
                    horizontal-stretch: 1;
                }

                // Reserve the absolute collapse control at the right edge.
                Rectangle {
                    width: 24px;
                }

            }

            // Side docks reserve a full second line for the path.
            Rectangle {
                visible: root.side-docked && root.panel-mode == "files" && root.toolbar-enabled;
                z: 1;
                x: 6px;
                y: 33px;
                width: parent.width - 12px;
                height: 22px;
                clip: true;
                border-radius: Theme.radius-sm;
                background: Theme.bg-root;
                border-width: 1px;
                border-color: side-path-input.has-focus ? Theme.accent : Theme.border-subtle;
                side-path-input := AutoScrollTextInput {
                    x: 6px;
                    width: parent.width - 12px;
                    height: parent.height;
                    text: root.current-path;
                    text-color: Theme.text-primary;
                    font-family: Theme.ui-font-family;
                    font-size: Theme.fs-sm;
                    read-only: !root.toolbar-enabled;
                    accepted => { if (root.toolbar-enabled) { root.navigate(self.text); } }
                }
            }

            // The navigation buttons precede the flexible path placeholder.
            // In a side dock that placeholder is transparent, but still fills
            // the space between Refresh and Collapse until it is compressed.
            Rectangle {
                visible: root.panel-mode == "files" && root.toolbar-enabled;
                z: 2;
                x: min(path-wrap.x - 56px, parent.width - 6px - 24px - 4px - 24px - 4px - 24px);
                y: 5px; width: 24px; height: 22px;
                border-radius: Theme.radius-sm;
                background: up-ta.has-hover ? Theme.bg-hover : transparent;
                up-ta := TouchArea { mouse-cursor: pointer; clicked => { root.navigate(".."); } }
                SftpToolbarIcon { width: parent.width; height: parent.height; glyph: "\u{E5D8}"; glyph-color: Theme.text-secondary; glyph-size: Theme.fs-md; }
                SftpTooltip { text: root.lang-en ? "Parent directory" : "上级目录"; hover: up-ta.has-hover; }
            }
            Rectangle {
                visible: root.panel-mode == "files" && root.toolbar-enabled;
                z: 2;
                x: min(path-wrap.x - 28px, parent.width - 6px - 24px - 4px - 24px);
                y: 5px; width: 24px; height: 22px;
                border-radius: Theme.radius-sm;
                background: ref-ta.has-hover ? Theme.bg-hover : transparent;
                ref-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected-row = -1;
                        root.selection-anchor-row = -1;
                        root.sync-path-inputs();
                        root.refresh(root.current-path);
                    }
                }
                SftpToolbarIcon { width: parent.width; height: parent.height; glyph: "\u{E5D5}"; glyph-color: Theme.text-secondary; glyph-size: Theme.fs-sm; }
                SftpTooltip { text: root.lang-en ? "Refresh" : "刷新"; hover: ref-ta.has-hover; }
            }

            Rectangle {
                x: parent.width - 6px - 24px;
                y: 5px; width: 24px; height: 22px;
                border-radius: Theme.radius-sm;
                background: min-ta.has-hover ? Theme.bg-hover : transparent;
                min-ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-collapsed(); } }
                Text {
                       text: root.collapsed
                           ? (root.dock-edge == "right" ? "\u{E5CB}" : root.dock-edge == "top" ? "\u{E5CF}" : root.dock-edge == "bottom" ? "\u{E5CE}" : "\u{E5CC}")
                           : (root.dock-edge == "right" ? "\u{E5CC}" : root.dock-edge == "top" ? "\u{E5CE}" : root.dock-edge == "bottom" ? "\u{E5CF}" : "\u{E5CB}");
                       font-family: "Material Icons"; color: Theme.text-secondary; font-size: Theme.fs-md;
                       horizontal-alignment: center; vertical-alignment: center;
                       width: parent.width; height: parent.height; }
            }
        }

        // --- Main area: tree (left) + file list (right) --------------------
        if root.panel-mode == "files" : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0;

            // 鈹€鈹€ Left: directory tree (hidden when the panel is narrow) 鈹€鈹€鈹€鈹€鈹€鈹€
            if root.show-tree : VerticalLayout {
                width: root.tree-width;
                spacing: 0;

                // Tree header
                Rectangle {
                    height: 20px;
                    background: Theme.bg-root;
                    Text {
                        x: 8px;
                        text: @tr("Directory tree");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }

                // Tree list with scrollbar
                tree-area := Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    tree-list := ListView {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: self.width;

                        for node[i] in root.tree-nodes : Rectangle {
                            height: 22px;
                            background: (toggle-ta.has-hover || name-ta.has-hover)
                                ? Theme.sftp-row-hover
                                : ((root.focused-tree-path != "" ? node.path == root.focused-tree-path : node.path == root.current-path)
                                    ? Theme.sftp-row-focus
                                    : (root.zebra-rows && mod(i, 2) != 0 ? Theme.bg-row-alt : Theme.term-bg));

                            HorizontalLayout {
                                spacing: 0;
                                padding-top: 1px;

                                // Depth indent spacer
                                Rectangle { width: 6px + node.depth * 12px; }

                                // Expand/collapse arrow. This only toggles the left tree;
                                // it intentionally does not navigate the right file list.
                                Rectangle {
                                    width: 14px;
                                    height: parent.height;

                                    toggle-ta := TouchArea {
                                        mouse-cursor: node.is-dir ? pointer : default;
                                        clicked => {
                                            input-blur-scope.focus();
                                            root.focused-tree-path = node.path;
                                            if (node.is-dir) {
                                                root.tree-expand(node.path, node.expanded);
                                            }
                                        }
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.back) {
                                                root.navigate-back();
                                                return;
                                            } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.forward) {
                                                root.navigate-forward();
                                                return;
                                            }
                                            if (node.name == "加载全部..." || node.name == "⏫收起") {
                                                return;
                                            }
                                            if (ev.kind == PointerEventKind.down
                                                    && ev.button == PointerEventButton.right
                                                    && node.is-dir) {
                                                root.tree-name-click-pending = false;
                                                root.focused-tree-path = node.path;
                                                root.menu-target = node.path;
                                                root.menu-target-name = node.depth == 0 ? "/" : node.name;
                                                root.menu-target-row = -1;
                                                root.menu-target-is-dir = true;
                                                root.menu-target-mode = 0;
                                                root.tree-menu-x = self.absolute-position.x + self.mouse-x - tree-area.absolute-position.x;
                                                root.tree-menu-y = self.absolute-position.y + self.mouse-y - tree-area.absolute-position.y;
                                                tree-menu.show();
                                            }
                                        }
                                    }

                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: node.has-children
                                            ? (node.expanded ? "\u{E5CF}" : "\u{E5CC}")
                                            : " ";
                                        font-family: "Material Icons";
                                        color: Theme.text-muted;
                                        font-size: Theme.fs-sm;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Node name. Folder names navigate the right file list;
                                // files open externally.
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: parent.height;

                                    name-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            input-blur-scope.focus();
                                            root.focused-tree-path = node.path;
                                            if (node.is-dir) {
                                                if (root.tree-name-click-pending && root.pending-tree-click-path == node.path) {
                                                    root.tree-name-click-pending = false;
                                                    root.tree-expand(node.path, node.expanded);
                                                } else {
                                                    root.pending-tree-click-path = node.path;
                                                    root.tree-name-click-pending = true;
                                                    root.navigate(node.path);
                                                }
                                            } else if (node.name == "加载全部..." || node.name == "⏫收起") {
                                                root.tree-name-click-pending = false;
                                                root.tree-load-more(node.path);
                                            } else {
                                                root.tree-name-click-pending = false;
                                                root.open-external(node.path);
                                            }
                                        }
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.back) {
                                                root.navigate-back();
                                                return;
                                            } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.forward) {
                                                root.navigate-forward();
                                                return;
                                            }
                                            if (node.name == "加载全部..." || node.name == "⏫收起") {
                                                return;
                                            }
                                            if (ev.kind == PointerEventKind.down
                                                    && ev.button == PointerEventButton.right
                                                    && node.is-dir) {
                                                root.tree-name-click-pending = false;
                                                root.focused-tree-path = node.path;
                                                root.menu-target = node.path;
                                                root.menu-target-name = node.depth == 0 ? "/" : node.name;
                                                root.menu-target-row = -1;
                                                root.menu-target-is-dir = true;
                                                root.menu-target-mode = 0;
                                                root.tree-menu-x = self.absolute-position.x + self.mouse-x - tree-area.absolute-position.x;
                                                root.tree-menu-y = self.absolute-position.y + self.mouse-y - tree-area.absolute-position.y;
                                                tree-menu.show();
                                            }
                                        }
                                    }

                                    Text {
                                        x: 2px;
                                        width: 18px;
                                        text: node.depth == 0 || node.name == "加载全部..." || node.name == "⏫收起" ? "" : (node.is-dir ? (node.expanded ? "📂" : "📁") : "📄");
                                        font-family: "Segoe UI Emoji";
                                        font-size: Theme.fs-sm;
                                        height: parent.height;
                                        overflow: clip;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        x: node.depth == 0 || node.name == "加载全部..." || node.name == "⏫收起" ? 2px : 24px;
                                        text: node.depth == 0 ? "/" : (node.name == "加载全部..." ? "⏬ " + root.load-all-label : (node.name == "⏫收起" ? node.name : node.name));
                                        color: node.path == root.current-path
                                            ? Theme.accent
                                            : (node.is-dir ? Theme.text-primary : Theme.text-secondary);
                                        font-size: Theme.fs-sm;
                                        width: node.depth == 0 || node.name == "加载全部..." || node.name == "⏫收起" ? parent.width - 4px : parent.width - 26px;
                                        height: parent.height;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    tree-scroll-timer := Timer {
                        interval: 0ms;
                        running: root.tree-scroll-pending;
                        triggered => {
                            if (root.tree-focus-index >= 0
                                    && (root.tree-focus-index * 22px < -tree-list.viewport-y
                                        || (root.tree-focus-index + 1) * 22px > -tree-list.viewport-y + tree-list.height)) {
                                tree-list.viewport-y = min(0px,
                                    tree-list.height / 5 - root.tree-focus-index * 22px - 11px);
                            }
                            root.tree-scroll-pending = false;
                        }
                    }

                    tree-menu := PopupWindow {
                        x: root.tree-menu-x;
                        y: root.tree-menu-y;
                        width: 176px;
                        height: 10 * 27px + 8px;
                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: Theme.bg-panel;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                SftpMenuItem {
                                    label: @tr("Download");
                                    enabled: root.menu-target != "";
                                    clicked => { root.download(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: root.lang-en ? "Archive download (.tar)" : "打包下载(.tar)";
                                    enabled: root.menu-target != "";
                                    clicked => { root.archive-download(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Rename");
                                    enabled: root.menu-target != "";
                                    clicked => {
                                        root.rename-request(root.menu-target, root.menu-target-name);
                                    }
                                }
                                SftpMenuItem {
                                    label: root.lang-en ? "Move..." : "移动...";
                                    enabled: root.menu-target != "";
                                    clicked => {
                                        root.move-request(root.menu-target, root.menu-target-name);
                                    }
                                }
                                SftpMenuItem {
                                    label: @tr("Copy path");
                                    enabled: root.menu-target != "";
                                    clicked => { root.copy-path(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Delete");
                                    tint: #d86c6c;
                                    enabled: root.menu-target != "";
                                    clicked => { root.delete(root.menu-target); }
                                }
                                Rectangle { height: 1px; background: Theme.border-subtle; }
                                SftpMenuItem {
                                    label: @tr("New folder");
                                    enabled: root.menu-target != "";
                                    clicked => { root.new-folder(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("New file");
                                    enabled: root.menu-target != "";
                                    clicked => { root.new-file(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Refresh");
                                    enabled: root.menu-target != "";
                                    clicked => {
                                        root.selected-row = -1;
                                        root.selection-anchor-row = -1;
                                        root.refresh(root.menu-target);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Vertical separator (only when the tree is shown)
            tree-resize-splitter := Rectangle {
                visible: root.show-tree;
                width: 0px;
                property <bool> hover-lit;
                property <bool> hover-pending;
                property <bool> dragging;
                background: transparent;
                z: 20;

                resize-hover-timer := Timer {
                    interval: 180ms;
                    running: parent.hover-pending;
                    triggered => {
                        parent.hover-lit = true;
                        parent.hover-pending = false;
                    }
                }

                Rectangle {
                    x: -2px;
                    width: 4px;
                    height: parent.height;
                    background: transparent;

                    Rectangle {
                        width: (tree-resize-splitter.hover-lit || tree-resize-splitter.dragging) ? parent.width : 1px;
                        height: parent.height;
                        x: (parent.width - self.width) / 2;
                        background: Theme.border-subtle;
                    }

                    resize-ta := TouchArea {
                        mouse-cursor: ew-resize;
                        changed has-hover => {
                            if (self.has-hover) {
                                tree-resize-splitter.hover-pending = true;
                            } else {
                                tree-resize-splitter.hover-pending = false;
                                tree-resize-splitter.hover-lit = false;
                            }
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down) {
                                tree-resize-splitter.dragging = true;
                            } else if (ev.kind == PointerEventKind.up) {
                                tree-resize-splitter.dragging = false;
                            }
                        }
                        moved => {
                            root.tree-width = max(root.tree-min-width,
                                min(root.tree-max-width,
                                    self.absolute-position.x + self.mouse-x - root.absolute-position.x));
                        }
                    }
                }
            }

            // 鈹€鈹€ Right: file listing 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
            VerticalLayout {
                horizontal-stretch: 1;
                width: root.list-w;
                spacing: 0;

                // Column headers
                Rectangle {
                    width: root.list-w;
                    height: 20px;
                    background: Theme.bg-root;
                    clip: true;
                    HorizontalLayout {

                        padding-left: 0px; padding-right: 0px; spacing: 0px;
                        SftpHeaderCell {
                            label: @tr("Name"); column: "name";
                            sort-column: root.sort-column; sort-asc: root.sort-asc;
                            left-align: root.side-docked;
                            width: root.name-col-view-w;
                            current-width: root.name-col-view-w;
                            col-min-w: 120px;
                            col-max-w: root.name-col-max-w;
                            resize-to(w) => { root.name-col-w = max(120px, min(root.name-col-max-w, w)); }
                            clicked(c) => {
                                root.sort-asc = root.sort-column == c ? !root.sort-asc : true;
                                root.sort-column = c;
                                root.sort-request(root.sort-column, root.sort-asc);
                            }
                        }
                        if root.show-size-col : SftpHeaderCell {
                            label: @tr("Size"); column: "size"; align-right: true;
                            sort-column: root.sort-column; sort-asc: root.sort-asc;
                            left-align: root.side-docked;
                            width: root.size-col-view-w;
                            current-width: root.size-col-w;
                            col-min-w: 64px;
                            resize-to(w) => { root.size-col-w = w; }
                            clicked(c) => {
                                root.sort-asc = root.sort-column == c ? !root.sort-asc : true;
                                root.sort-column = c;
                                root.sort-request(root.sort-column, root.sort-asc);
                            }
                        }
                        if root.show-type-col : SftpHeaderCell {
                            label: root.lang-en ? "Type" : "类型"; column: "type";
                            sort-column: root.sort-column; sort-asc: root.sort-asc;
                            left-align: root.side-docked;
                            width: root.type-col-view-w;
                            current-width: root.type-col-w;
                            col-min-w: 64px;
                            resize-to(w) => { root.type-col-w = w; }
                            clicked(c) => {
                                root.sort-asc = root.sort-column == c ? !root.sort-asc : true;
                                root.sort-column = c;
                                root.sort-request(root.sort-column, root.sort-asc);
                            }
                        }
                        if root.show-modified-col : SftpHeaderCell {
                            label: @tr("Modified"); column: "modified"; align-right: true;
                            sort-column: root.sort-column; sort-asc: root.sort-asc;
                            left-align: root.side-docked;
                            width: root.modified-col-view-w;
                            current-width: root.modified-col-w;
                            col-min-w: 80px;
                            resize-to(w) => { root.modified-col-w = w; }
                            clicked(c) => {
                                root.sort-asc = root.sort-column == c ? !root.sort-asc : true;
                                root.sort-column = c;
                                root.sort-request(root.sort-column, root.sort-asc);
                            }
                        }
                        if root.show-perm-col : SftpHeaderCell {
                            label: root.lang-en ? "Perm" : "权限"; column: "permissions";
                            sort-column: root.sort-column; sort-asc: root.sort-asc;
                            left-align: root.side-docked;
                            width: root.perm-col-view-w;
                            current-width: root.perm-col-w;
                            col-min-w: 64px;
                            resize-to(w) => { root.perm-col-w = w; }
                            clicked(c) => {
                                root.sort-asc = root.sort-column == c ? !root.sort-asc : true;
                                root.sort-column = c;
                                root.sort-request(root.sort-column, root.sort-asc);
                            }
                        }
                        if root.show-owner-col : SftpHeaderCell {
                            label: root.lang-en ? "User / Group" : "用户/用户组"; column: "owner";
                            sort-column: root.sort-column; sort-asc: root.sort-asc;
                            left-align: root.side-docked;
                            horizontal-stretch: 1;
                            min-width: root.owner-min-w;
                            resizable: false;
                            clicked(c) => {
                                root.sort-asc = root.sort-column == c ? !root.sort-asc : true;
                                root.sort-column = c;
                                root.sort-request(root.sort-column, root.sort-asc);
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }

                // File list. Use ListView instead of ScrollView + VerticalLayout so
                // Slint can keep only the visible file rows alive. This avoids
                // creating thousands of row components for very large folders.
                file-area := Rectangle {
                    width: root.list-w;
                    vertical-stretch: 1;
                    clip: true;

                    // Whitespace below/around the virtualized rows: right-click here
                    // opens the menu with no target (item actions greyed out) (#84).
                    ws-ta := TouchArea {
                        clicked => {
                                input-blur-scope.focus();
                                root.selected-row = -1;
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.back) {
                                root.navigate-back();
                                return;
                            } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.forward) {
                                root.navigate-forward();
                                return;
                            }
                            if (ev.kind == PointerEventKind.down
                                    && ev.button == PointerEventButton.right) {
                                root.selected-row = -1;
                                root.menu-target = "";
                                root.menu-target-row = -1;
                                root.menu-x = self.absolute-position.x + self.mouse-x - file-area.absolute-position.x;
                                root.menu-y = self.absolute-position.y + self.mouse-y - file-area.absolute-position.y;
                                file-menu.show();
                            }
                        }
                    }

                    file-list := ListView {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: self.width;
                        viewport-y <=> root.file-viewport-y;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;


                        for entry[i] in root.entries : row := Rectangle {
                            height: 24px;
                            background: entry.selected
                                ? Theme.sftp-row-selected
                                : (i == root.selected-row
                                    ? Theme.sftp-row-focus
                                    : (row-ta.has-hover
                                        ? Theme.sftp-row-hover
                                        : (root.zebra-rows && mod(i, 2) != 0 ? Theme.bg-row-alt : Theme.term-bg)));

                            row-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    input-blur-scope.focus();
                                    if (entry.full-path == "__MEATSHELL_LOAD_MORE__") {
                                        root.load-more();
                                        return;
                                    }
                                    if (entry.full-path == "__MEATSHELL_LOAD_ALL__") {
                                        root.load-all();
                                        return;
                                    }
                                }
                                double-clicked => {
                                    input-blur-scope.focus();
                                    if (entry.full-path == "__MEATSHELL_LOAD_MORE__") {
                                        root.load-more();
                                        return;
                                    }
                                    if (entry.full-path == "__MEATSHELL_LOAD_ALL__") {
                                        root.load-all();
                                        return;
                                    }
                                    if (root.suppress-double-open) {
                                        root.suppress-double-open = false;
                                        return;
                                    }
                                    root.open-entry(entry.full-path, entry.is-dir);
                                }
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.back) {
                                        root.navigate-back();
                                        return;
                                    } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.forward) {
                                        root.navigate-forward();
                                        return;
                                    }
                                    if (ev.kind == PointerEventKind.down
                                            && ev.button == PointerEventButton.left) {
                                        input-blur-scope.focus();
                                        if (entry.full-path == "__MEATSHELL_LOAD_MORE__" || entry.full-path == "__MEATSHELL_LOAD_ALL__") {
                                            return;
                                        }
                                        root.suppress-double-open = ev.modifiers.shift
                                            || (Theme.is-mac ? ev.modifiers.meta : ev.modifiers.control);
                                        if (ev.modifiers.shift && root.selection-anchor-row >= 0) {
                                            root.selected-row = i;
                                            root.select-range(root.selection-anchor-row, i,
                                                Theme.is-mac ? ev.modifiers.meta : ev.modifiers.control);
                                        } else if (Theme.is-mac ? ev.modifiers.meta : ev.modifiers.control) {
                                            root.selected-row = entry.selected ? -1 : i;
                                            root.toggle-select(i);
                                            root.selection-anchor-row = i;
                                        } else {
                                            root.selected-row = i;
                                            root.select-single(i);
                                            root.selection-anchor-row = i;
                                        }
                                    }
                                    if (ev.kind == PointerEventKind.down
                                            && ev.button == PointerEventButton.right) {
                                        if (entry.full-path == "__MEATSHELL_LOAD_MORE__" || entry.full-path == "__MEATSHELL_LOAD_ALL__") {
                                            return;
                                        }
                                        root.selected-row = i;
                                        if (!entry.selected) {
                                            root.select-single(i);
                                            root.selection-anchor-row = i;
                                        }
                                        root.menu-target = entry.full-path;
                                        root.menu-target-name = entry.name;
                                        root.menu-target-row = i;
                                        root.menu-target-is-dir = entry.is-dir;
                                        root.menu-target-mode = entry.mode;
                                        root.menu-x = self.absolute-position.x + self.mouse-x - file-area.absolute-position.x;
                                        root.menu-y = self.absolute-position.y + self.mouse-y - file-area.absolute-position.y;
                                        file-menu.show();
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 0px; padding-right: 0px; spacing: 0px;
                                Rectangle {
                                    width: root.name-col-view-w;
                                    if entry.full-path == "__MEATSHELL_LOAD_MORE__" || entry.full-path == "__MEATSHELL_LOAD_ALL__" : Text {
                                        x: 6px;
                                        width: parent.width - 12px;
                                        text: entry.full-path == "__MEATSHELL_LOAD_MORE__" ? "... " + root.load-more-label : "⏬ " + root.load-all-label;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-sm;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    if entry.full-path != "__MEATSHELL_LOAD_MORE__" && entry.full-path != "__MEATSHELL_LOAD_ALL__" : HorizontalLayout {
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: parent.height;
                                        spacing: 4px;
                                        Text {
                                            width: 18px;
                                            text: entry.icon;
                                            font-family: "Segoe UI Emoji";
                                            font-size: Theme.fs-sm;
                                            overflow: clip;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: entry.name;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-sm;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                if root.show-size-col : Rectangle {
                                    width: root.size-col-view-w;
                                    Text { x: 6px; width: parent.width - 12px; text: entry.is-dir ? "" : entry.size;
                                        color: Theme.text-secondary; font-size: Theme.fs-xs; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                }
                                if root.show-type-col : Rectangle {
                                    width: root.type-col-view-w;
                                    Text { x: 6px; width: parent.width - 12px; text: root.lang-en ? entry.kind-en : entry.kind;
                                        color: Theme.text-muted; font-size: Theme.fs-xs; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                }
                                if root.show-modified-col : Rectangle {
                                    width: root.modified-col-view-w;
                                    Text { x: 6px; width: parent.width - 12px; text: entry.modified;
                                        color: Theme.text-muted; font-size: Theme.fs-xs; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                }
                                if root.show-perm-col : Rectangle {
                                    width: root.perm-col-view-w;
                                    Text { x: 6px; width: parent.width - 12px; text: entry.permissions;
                                        color: Theme.text-muted; font-size: Theme.fs-xs; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                }
                                if root.show-owner-col : Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: root.owner-min-w;
                                    Text { x: 6px; width: parent.width - 12px; text: entry.owner + (entry.group != "" ? "/" + entry.group : "");
                                        color: Theme.text-muted; font-size: Theme.fs-xs; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                }
                            }
                        }
                    }

                    file-scroll-timer := Timer {
                        interval: 16ms;
                        running: root.file-scroll-attempts > 0;
                        triggered => {
                            if (root.file-scroll-mode == 1) {
                                file-list.viewport-y = 0px;
                            } else if (root.file-scroll-mode == 2) {
                                let bottom-y = min(0px,
                                    file-list.height - root.entries.length * 24px);
                                file-list.viewport-y = max(bottom-y,
                                    min(0px, root.restore-viewport-y));
                            } else if (root.file-scroll-mode == 3 && root.restore-selected-row >= 0) {
                                let row-top = root.restore-selected-row * 24px;
                                let desired-y = file-list.height / 4 - row-top - 12px;
                                let bottom-y = min(0px,
                                    file-list.height - root.entries.length * 24px);
                                file-list.viewport-y = max(bottom-y, min(0px, desired-y));
                            }
                            root.file-scroll-attempts -= 1;
                        }
                    }

                    // ListView supports exactly one child, and it must be the row `for` loop.
                    // Keep transient status messages outside the ListView as overlays.

                    if !root.loading && root.entries.length == 0 : Rectangle {
                        width: parent.width;
                        height: 40px;
                        y: 0px;
                        Text {
                            text: @tr("Empty directory");
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // One context menu for the whole list (#84). Item actions are
                    // enabled only when an item was right-clicked (menu-target set);
                    // new/refresh are always available.
                    copy-target-menu := PopupWindow {
                        x: root.menu-x + 176px;
                        y: root.menu-y;
                        width: 176px;
                        height: max(1, root.transfer-targets.length) * 27px + 8px;
                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: Theme.bg-panel;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                for target in root.transfer-targets : SftpMenuItem {
                                    label: target.title;
                                    enabled: target.kind == "terminal" && target.connected && target.id != root.current-tab-id;
                                    clicked => {
                                        if (root.selected-count >= 2) {
                                            root.copy-selected-to-target(target.id);
                                        } else if (root.menu-target != "") {
                                            root.copy-to-target(root.menu-target, target.id);
                                        } else {
                                            root.copy-selected-to-target(target.id);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    file-menu := PopupWindow {
                        x: root.menu-x;
                        y: root.menu-y;
                        width: 176px;
                        height: 15 * 27px + 8px;
                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: Theme.bg-panel;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #00000060;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                SftpMenuItem {
                                    label: @tr("Download");
                                    enabled: root.menu-target != "" || root.selected-count > 0;
                                    clicked => {
                                        if (root.selected-count > 0) {
                                            root.download-selected();
                                        } else {
                                            root.download(root.menu-target);
                                        }
                                    }
                                }
                                SftpMenuItem {
                                    label: root.lang-en ? "Archive download (.tar)" : "打包下载(.tar)";
                                    enabled: root.menu-target != "" || root.selected-count > 0;
                                    clicked => {
                                        if (root.selected-count > 0) {
                                            root.archive-download-selected();
                                        } else {
                                            root.archive-download(root.menu-target);
                                        }
                                    }
                                }
                                SftpMenuItem {
                                    label: @tr("View");
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.view(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Edit");
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.edit(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Open externally");
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.open-external(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Edit externally");
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.edit-external(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Rename");
                                    enabled: root.menu-target != "";
                                    clicked => {
                                        root.rename-request(root.menu-target, root.menu-target-name);
                                    }
                                }
                                SftpMenuItem {
                                    label: root.lang-en ? "Move..." : "移动...";
                                    enabled: root.menu-target != "" || root.selected-count > 0;
                                    clicked => {
                                        if (root.selected-count > 0) {
                                            root.move-selected-request();
                                        } else {
                                            root.move-request(root.menu-target, root.menu-target-name);
                                        }
                                    }
                                }
                                SftpMenuItem {
                                    label: @tr("Permissions");
                                    enabled: root.menu-target != "";
                                    clicked => { root.chmod-request(root.menu-target, root.menu-target-name, root.menu-target-mode); }
                                }
                                SftpMenuItem {
                                    label: @tr("Copy path");
                                    enabled: root.menu-target != "";
                                    clicked => { root.copy-path(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Copy to session...");
                                    enabled: (root.menu-target != "" || root.selected-count > 0) && root.transfer-targets.length > 1;
                                    clicked => { copy-target-menu.show(); }
                                }
                                SftpMenuItem {
                                    label: @tr("Delete");
                                    tint: #d86c6c;
                                    enabled: root.menu-target != "" || root.selected-count > 0;
                                    clicked => {
                                        if (root.selected-count > 0) {
                                            root.delete-selected();
                                        } else {
                                            root.delete(root.menu-target);
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.border-subtle; }
                                SftpMenuItem {
                                    label: @tr("New folder");
                                    clicked => { root.new-folder(root.current-path); }
                                }
                                SftpMenuItem {
                                    label: @tr("New file");
                                    clicked => { root.new-file(root.current-path); }
                                }
                                SftpMenuItem {
                                    label: @tr("Refresh");
                                    clicked => {
                                        root.selected-row = -1;
                                        root.selection-anchor-row = -1;
                                        root.sync-path-inputs();
                                        root.refresh(root.current-path);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.panel-mode == "tunnels" : Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: transparent;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 10px;
                spacing: 8px;

                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 54px; height: 24px; border-radius: Theme.radius-sm;
                            background: root.tunnel-kind == "local" ? Theme.accent : (tl-ta.has-hover ? Theme.bg-hover : Theme.bg-root);
                            tl-ta := TouchArea { mouse-cursor: pointer; clicked => { root.tunnel-kind = "local"; } }
                            Text { text: "-L"; color: root.tunnel-kind == "local" ? #ffffff : Theme.text-primary; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 54px; height: 24px; border-radius: Theme.radius-sm;
                            background: root.tunnel-kind == "dynamic" ? Theme.accent : (td-ta.has-hover ? Theme.bg-hover : Theme.bg-root);
                            td-ta := TouchArea { mouse-cursor: pointer; clicked => { root.tunnel-kind = "dynamic"; } }
                            Text { text: "-D"; color: root.tunnel-kind == "dynamic" ? #ffffff : Theme.text-primary; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 72px; height: 24px; border-radius: Theme.radius-sm;
                            background: clear-failed-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                            clear-failed-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.clear-failed-tunnels(); }
                            }
                            Text { text: root.lang-en ? "Clear failed" : "清除失败"; color: Theme.text-secondary; font-size: Theme.fs-xs; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 72px; height: 24px; border-radius: Theme.radius-sm;
                            background: add-tunnel-ta.has-hover ? Theme.accent-hover : Theme.accent;
                            add-tunnel-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (root.tunnel-bind-port != "" && (root.tunnel-kind == "dynamic" || (root.tunnel-host != "" && root.tunnel-host-port != ""))) {
                                        root.tunnel-add(root.tunnel-name, root.tunnel-kind, root.tunnel-bind, root.tunnel-bind-port, root.tunnel-host, root.tunnel-host-port);
                                    }
                                }
                            }
                            Text { text: @tr("Add"); color: #ffffff; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }

                    Rectangle {
                        height: 24px;
                        property <length> wide-field-w: (parent.width - 16px) * 2 / 5;
                        Rectangle {
                            x: 0px; width: parent.wide-field-w; height: parent.height; border-radius: Theme.radius-sm;
                            background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                            tunnel-name-input := TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-name; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; }
                            if tunnel-name-input.text == "" : Text { x: 7px; width: parent.width - 14px; height: parent.height; text: root.lang-en ? "Name (optional)" : "名称（可选）"; color: Theme.text-muted; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; vertical-alignment: center; }
                        }
                        Rectangle {
                            x: parent.wide-field-w + 8px; width: parent.wide-field-w; height: parent.height; border-radius: Theme.radius-sm;
                            background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                            tunnel-bind-input := TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-bind; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; }
                            if tunnel-bind-input.text == "" : Text { x: 7px; width: parent.width - 14px; height: parent.height; text: "127.0.0.1"; color: Theme.text-muted; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; vertical-alignment: center; }
                        }
                        Rectangle {
                            x: 2 * parent.wide-field-w + 16px; width: parent.width - self.x; height: parent.height; border-radius: Theme.radius-sm;
                            background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                            tunnel-bind-port-input := TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-bind-port; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; }
                            if tunnel-bind-port-input.text == "" : Text { x: 7px; width: parent.width - 14px; height: parent.height; text: root.lang-en ? "Listen port" : "监听端口"; color: Theme.text-muted; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; vertical-alignment: center; }
                        }
                    }

                    if root.tunnel-kind == "local" : Rectangle {
                        height: 24px;
                        property <length> target-host-w: (parent.width - 16px) * 4 / 5 + 8px;
                        Rectangle {
                            x: 0px; width: parent.target-host-w; height: parent.height; border-radius: Theme.radius-sm;
                            background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                            tunnel-host-input := TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-host; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; }
                            if tunnel-host-input.text == "" : Text { x: 7px; width: parent.width - 14px; height: parent.height; text: root.lang-en ? "Target host" : "目标主机"; color: Theme.text-muted; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; vertical-alignment: center; }
                        }
                        Rectangle {
                            x: parent.target-host-w + 8px; width: parent.width - self.x; height: parent.height; border-radius: Theme.radius-sm;
                            background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                            tunnel-host-port-input := TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-host-port; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; }
                            if tunnel-host-port-input.text == "" : Text { x: 7px; width: parent.width - 14px; height: parent.height; text: root.lang-en ? "Target port" : "目标端口"; color: Theme.text-muted; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; vertical-alignment: center; }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    ScrollView {
                        vertical-stretch: 1;
                        viewport-width: self.visible-width;
                        viewport-height: max(self.visible-height, tunnel-history.preferred-height);
                        tunnel-history := VerticalLayout {
                            width: parent.width;
                            spacing: 8px;

                    if root.tunnels.length == 0 : Rectangle {
                        height: 36px;
                        Text { text: @tr("No tunnels"); color: Theme.text-muted; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    for tun in root.tunnels : Rectangle {
                        height: 34px;
                        border-radius: Theme.radius-sm;
                        background: tunnel-row-ta.has-hover ? Theme.bg-hover : Theme.bg-root.with-alpha(0.42);
                        tunnel-row-ta := TouchArea {}
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                            Text { text: tun.active ? "●" : "○"; color: tun.active ? #28c76f : Theme.text-muted; width: 14px; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-alignment: center; }
                            Text { text: tun.kind == "dynamic" ? "-D" : (tun.kind == "remote" ? "-R" : "-L"); color: Theme.text-muted; width: 28px; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-alignment: center; }
                            Text { text: tun.name; color: Theme.text-primary; width: 120px; font-size: Theme.fs-sm; overflow: elide; vertical-alignment: center; }
                            Text { text: tun.bind + (tun.target != "" ? " → " + tun.target : ""); color: Theme.text-secondary; horizontal-stretch: 1; font-size: Theme.fs-xs; overflow: elide; vertical-alignment: center; }
                            Text { text: tun.status; color: tun.active ? Theme.accent : Theme.text-muted; width: 62px; font-size: Theme.fs-xs; overflow: elide; vertical-alignment: center; horizontal-alignment: right; }
                            VerticalLayout {
                                width: 48px;
                                alignment: center;
                                Rectangle {
                                    height: 22px; border-radius: Theme.radius-sm;
                                    background: tun.active ? (stop-ta.has-hover ? Theme.danger.with-alpha(0.24) : transparent) : transparent;
                                    stop-ta := TouchArea { mouse-cursor: tun.active ? pointer : default; clicked => { if (tun.active) { root.tunnel-stop(tun.id); } } }
                                    Text { text: @tr("Stop"); color: tun.active ? Theme.danger : Theme.text-muted; font-size: Theme.fs-xs; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                        }
                    }
                }
            }

        // --- Status bar (full width) --------------------------------------
        Rectangle { height: 1px; background: Theme.border-subtle; }
        Rectangle {
            height: 22px;
            background: Theme.bg-root;
            Text {
                x: 8px;
                y: -1px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.selected-count > 0
                    ? root.status + (root.lang-en ? "    Selected " + root.selected-count + " item(s)" : "    已选择 " + root.selected-count + " 个项目")
                    : root.status;
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

}
