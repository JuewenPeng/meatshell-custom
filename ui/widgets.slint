import { Theme } from "theme.slint";

// --- IconButton ------------------------------------------------------------
// A small square action button that accepts a single-character glyph (or short text).
// Keeps visual language consistent across the app.
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> glyph-font-family: Theme.ui-font-family;
    in property <string> tooltip;
    in property <length> size: 28px;
    in property <brush> fg: Theme.text-secondary;
    in property <brush> fg-hover: Theme.text-primary;
    callback clicked();

    width: size;
    height: size;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.bg-hover : transparent;
    animate background { duration: 120ms; }

    Text {
        text: glyph;
        font-family: root.glyph-font-family;
        color: touch.has-hover ? fg-hover : fg;
        font-size: Theme.fs-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// --- PrimaryButton ---------------------------------------------------------
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> disabled: false;
    callback clicked();

    height: 30px;
    min-width: 80px;
    border-radius: Theme.radius-sm;
    background: disabled
        ? Theme.bg-elevated
        : (touch.pressed ? Theme.accent-pressed
           : (touch.has-hover ? Theme.accent-hover : Theme.accent));
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: disabled ? Theme.text-muted : white;
            font-size: Theme.fs-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// --- GhostButton -----------------------------------------------------------
export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    height: 30px;
    min-width: 80px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : (touch.has-hover ? Theme.border-strong : Theme.border-subtle);
    background: root.selected ? Theme.accent
        : (touch.pressed ? Theme.bg-active
        : (touch.has-hover ? Theme.bg-hover : Theme.bg-panel));
    animate background, border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: root.selected ? #ffffff : Theme.text-primary;
            font-size: Theme.fs-md;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// --- AutoScrollTextInput ---------------------------------------------------
// A bare single-line TextInput that keeps the cursor visible horizontally.
// It intentionally draws no background/border so callers can keep their custom
// field chrome while still getting LineEdit-like cursor-follow behavior.
export component AutoScrollTextInput inherits Rectangle {
    in-out property <string> text;
    in property <string> font-family;
    in property <length> font-size;
    in property <int> font-weight;
    in property <brush> text-color: Theme.text-primary;
    in property <InputType> input-type: InputType.text;
    in property <bool> read-only: false;
    in property <bool> input-enabled: true;
    in property <bool> auto-focus: false;
    out property <bool> has-focus: input.has-focus;
    out property <int> cursor-position_byte-offset: input.cursor-position_byte-offset;
    callback accepted();
    callback edited();
    callback input-key-pressed(KeyEvent) -> EventResult;
    callback input-key-released(KeyEvent) -> EventResult;

    property <length> scroll-x;
    clip: true;
    min-width: 1px;

    public function focus-input() {
        input.focus();
        root.scroll-to-end();
    }

    public function set-selection-offsets(start: int, end: int) {
        input.set-selection-offsets(start, end);
        root.keep-cursor-visible({ x: input.preferred-width, y: 0px });
    }

    public function select-all() { input.select-all(); }
    public function clear-selection() { input.clear-selection(); }
    public function cut() { input.cut(); }
    public function copy() { input.copy(); }
    public function paste() { input.paste(); }

    public function scroll-to-end() {
        input.set-selection-offsets(1000000, 1000000);
        root.scroll-x = min(0px, root.width - input.preferred-width - input.text-cursor-width);
    }

    public function keep-cursor-visible(pos: Point) {
        if (pos.x + root.scroll-x < 0px) {
            root.scroll-x = -pos.x;
        } else if (pos.x + root.scroll-x > root.width - input.text-cursor-width) {
            root.scroll-x = root.width - input.text-cursor-width - pos.x;
        }
    }

    changed width => {
        root.keep-cursor-visible({ x: input.preferred-width, y: 0px });
    }

    input := TextInput {
        x: root.scroll-x;
        width: max(root.width, self.preferred-width);
        height: root.height;
        text <=> root.text;
        color: root.text-color;
        font-family: root.font-family;
        font-size: root.font-size;
        font-weight: root.font-weight;
        vertical-alignment: center;
        single-line: true;
        input-type: root.input-type;
        read-only: root.read-only;
        enabled: root.input-enabled;
        init => {
            if (root.auto-focus) {
                root.focus-input();
            }
        }
        cursor-position-changed(pos) => { root.keep-cursor-visible(pos); }
        accepted => { root.accepted(); }
        edited => { root.edited(); }
        key-pressed(e) => { root.input-key-pressed(e) }
        key-released(e) => { root.input-key-released(e) }
    }
}

// --- LabeledInput ----------------------------------------------------------
export component LabeledInput inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    in property <bool> password: false;
    in property <bool> auto-focus: false;   // grab focus when shown (dialog fields)
    in property <brush> input-background: Theme.bg-root;
    in property <brush> idle-border: Theme.border-subtle;
    callback accepted();   // Enter pressed in the field
    callback canceled();   // Esc pressed in the field (#140-3)
    spacing: 4px;
    property <bool> focus-pending: false;
    public function focus-input() { input.focus-input(); }

    // A LabeledInput is often created inside a conditional dialog. Focusing its
    // TextInput during `init` asks Slint for IME geometry while the surrounding
    // layout binding is still being evaluated, which trips the runtime's
    // recursion guard. Defer focus until the next event-loop turn, after layout.
    init => { root.focus-pending = root.auto-focus; }
    focus-timer := Timer {
        interval: 0ms;
        running: root.focus-pending;
        triggered => {
            root.focus-pending = false;
            if (root.auto-focus) { input.focus-input(); }
        }
    }

    Text {
        text: label;
        color: Theme.text-secondary;
        font-size: Theme.fs-sm;
    }

    Rectangle {
        height: 32px;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : root.idle-border;
        background: root.input-background;

        input := AutoScrollTextInput {
            x: 10px;
            y: 0px;
            width: parent.width - 20px;
            height: parent.height;
            text <=> root.value;
            text-color: Theme.text-primary;
            // A CJK-capable family — TextInput doesn't glyph-fallback reliably
            // across machines, so typed Chinese (incl. punctuation like 、) can
            // render as tofu without an explicit font (#54).
            font-family: Theme.ui-font-family;
            font-size: Theme.fs-md;
            input-type: root.password ? InputType.password : InputType.text;
            accepted => { root.accepted(); }
            input-key-pressed(e) => {
                if (e.text == Key.Escape) { root.canceled(); accept }
                else { reject }   // let TextInput handle normal typing
            }
        }

        // Lightweight placeholder — shown when value is empty.
        if value == "" : Text {
            x: 10px;
            y: 0px;
            height: parent.height;
            text: placeholder;
            color: Theme.text-muted;
            font-size: Theme.fs-md;
            vertical-alignment: center;
        }
    }
}

// --- Sparkline -------------------------------------------------------------
// Compact horizontal bar chart used in the stats sidebar.
export component Sparkline inherits Rectangle {
    in property <[float]> values;
    in property <brush> line-color: Theme.accent;

    background: Theme.bg-root;
    border-radius: Theme.radius-sm;
    clip: true;

    for v[i] in values : Rectangle {
        x: i * (parent.width / max(1, values.length));
        y: parent.height - (parent.height * clamp(v, 0.0, 1.0));
        width: (parent.width / max(1, values.length)) - 1px;
        height: parent.height * clamp(v, 0.0, 1.0);
        background: line-color.with-alpha(0.85);
        border-radius: 1px;
    }
}

// --- DockExpandButton ------------------------------------------------------
// The little button shown when a dockable panel is collapsed, anchored to the
// edge it was docked on (chevron points toward where the panel reopens). Shared
// by the resource panel and the SFTP panel so they collapse/expand identically.
// The host is responsible for any reserved gap (e.g. the bottom edge) so this
// button never overlaps neighbouring chrome (#dock).
// IDEA-style collapsed tool strip (#v0.5 M5): when a dockable panel is collapsed
// the host renders this thin bar along the panel's docked edge instead of the
// panel. It shows the panel's tool icon; clicking re-expands. The host reserves
// the slot (≈36px) and fills this in; one reusable strip for welcome / resource /
// SFTP so they all collapse the same way.
export component ToolStrip inherits Rectangle {
    in property <string> dock-edge;   // left | right | top | bottom
    in property <string> glyph;       // the panel's tool icon (Material Icons)
    in property <bool> active: false;
    in property <bool> show-second: false;
    in property <string> second-glyph;
    in property <bool> second-active: false;
    in property <string> tooltip;
    in property <bool> enabled: true;
    callback expand();
    callback expand-second();
    property <bool> horizontal: root.dock-edge == "top" || root.dock-edge == "bottom";

    background: Theme.bg-toolstrip;
    // Hairline on the inner edge (facing the central content).
    Rectangle {
        x: root.dock-edge == "left" ? parent.width - self.width : 0px;
        y: root.dock-edge == "top" ? parent.height - self.height : 0px;
        width: root.horizontal ? parent.width : 1px;
        height: root.horizontal ? 1px : parent.height;
        background: Theme.border-subtle;
    }
    // Tool icon, hugging the strip's near corner.
    Rectangle {
        width: 30px;
        height: 30px;
        x: root.horizontal ? 4px : (parent.width - self.width) / 2;
        y: root.horizontal ? (parent.height - self.height) / 2 : 4px;
        border-radius: Theme.radius-sm;
         background: !root.enabled ? transparent
             : root.active ? Theme.accent.with-alpha(0.18)
             : ta.has-hover ? Theme.bg-hover : transparent;
         Text {
             text: root.glyph;
             font-family: "Material Icons";
             font-size: 18px;
             color: !root.enabled ? Theme.text-muted.with-alpha(0.45)
                 : root.active ? Theme.accent
                 : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
          ta := TouchArea {
              mouse-cursor: root.enabled ? pointer : default;
              clicked => {
                  if (root.enabled) {
                      root.expand();
                  }
              }
          }
      }
    if root.show-second : Rectangle {
        width: 30px;
        height: 30px;
        x: root.horizontal ? 38px : (parent.width - self.width) / 2;
        y: root.horizontal ? (parent.height - self.height) / 2 : 38px;
        border-radius: Theme.radius-sm;
        background: root.second-active ? Theme.accent.with-alpha(0.18)
            : ta2.has-hover ? Theme.bg-hover : transparent;
        Text {
            text: root.second-glyph;
            font-family: "Material Icons";
            font-size: 18px;
            color: root.second-active ? Theme.accent
                : ta2.has-hover ? Theme.text-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        ta2 := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expand-second(); }
        }
    }
}

export component DockExpandButton inherits Rectangle {
    in property <string> dock-edge;   // left | right | top | bottom
    // For top/bottom docks, hug the right corner instead of the left. SFTP uses
    // this so the expand button stays on the side its controls live on.
    in property <bool> hug-right: false;
    in property <bool> flat: false;
    callback expand();
    // Root is a transparent overlay that fills the host area; the actual button
    // positions itself within it (a component's own root may not reference
    // `parent`, so the button anchors to this filled overlay instead).
    background: transparent;
    btn := Rectangle {
        width: 24px;
        height: 22px;
        x: root.dock-edge == "right" ? parent.width - self.width - 2px
         : (root.dock-edge == "top" || root.dock-edge == "bottom")
           ? (root.hug-right ? parent.width - self.width - 6px : 6px)
         : 2px;
        y: (root.dock-edge == "top" || root.dock-edge == "bottom") ? (parent.height - self.height) / 2 : 8px;
        border-radius: Theme.radius-sm;
        background: ta.has-hover ? Theme.bg-hover : (root.flat ? transparent : Theme.bg-elevated);
        border-width: root.flat ? 0px : 1px;
        border-color: Theme.border-subtle;
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expand(); }
        }
        Text {
            text: root.dock-edge == "right"  ? "\u{E5CB}"   // chevron_left
                : root.dock-edge == "top"    ? "\u{E5CF}"   // expand_more
                : root.dock-edge == "bottom" ? "\u{E5CE}"   // expand_less
                : "\u{E5CC}";                                // chevron_right (left dock)
            font-family: "Material Icons";
            font-size: 16px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}
